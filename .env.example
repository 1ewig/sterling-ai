# ==============================================================================
# Argus — Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Inference Provider Configuration ('groq' | 'fireworks')
# ------------------------------------------------------------------------------
INFERENCE_PROVIDER=groq

# --- Groq Provider Configuration ---
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BACKUP_MODEL=openai/gpt-oss-120b
# Reasoning Effort / Thinking Level: 'none' | 'low' | 'medium' | 'high' (Default: 'low')
GROQ_REASONING_EFFORT=low
# Max output tokens per turn (safeguards against 8,000 TPM rate limits; default: 6000)
GROQ_MAX_TOKENS=6000

# --- Fireworks AI Provider Configuration ---
# Get your API key from: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
FIREWORKS_BACKUP_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
# Reasoning Effort / Thinking Level for Fireworks: 'low' | 'high' | 'max' (Default: 'low')
FIREWORKS_REASONING_EFFORT=low

# Optional: Set explicit backup failover provider ('groq' | 'fireworks')
# If unset, automatically fails over to Fireworks if FIREWORKS_API_KEY is provided.
BACKUP_INFERENCE_PROVIDER=


# ------------------------------------------------------------------------------
# 2. Qualitative Intelligence / Web Search (Exa AI)
# ------------------------------------------------------------------------------
# Used for live breaking crypto news, catalysts, sentiment, and web intelligence.
# Get your API key from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# ------------------------------------------------------------------------------
# 3. 8004scan Pro API (ERC-8004 Agent Registry)
# ------------------------------------------------------------------------------
# Optional: Higher rate limits for live agent indexing and telemetry
# Get your API key from: https://8004scan.io
SCAN8004_API_KEY=

