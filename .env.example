# ==============================================================================
# Sterling — Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Inference Provider Configuration ('fireworks' | 'bitget')
# ------------------------------------------------------------------------------
INFERENCE_PROVIDER=bitget

# --- Bitget AI Provider Configuration (OpenAI-compatible) ---
BITGET_AI_BASE_URL=https://hackathon.bitgetops.com/v1
BITGET_AI_API_KEY=
BITGET_AI_MODEL=qwen3.8-max
BITGET_AI_BACKUP_MODEL=qwen3.8-max
# Reasoning Effort / Thinking Level: 'none' | 'low' | 'medium' | 'high' (Default: 'low')
BITGET_AI_REASONING_EFFORT=low

# --- Fireworks AI Provider Configuration ---
# Get your API key from: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_BACKUP_MODEL=accounts/fireworks/models/glm-5p3-flash
# Reasoning Effort / Thinking Level for Fireworks: 'low' | 'high' | 'max' (Default: 'low')
FIREWORKS_REASONING_EFFORT=low

# Optional: Set explicit backup failover provider ('fireworks' | 'bitget')
# If unset, automatically fails over between Bitget AI and Fireworks AI.
BACKUP_INFERENCE_PROVIDER=


# ------------------------------------------------------------------------------
# 2. Qualitative Intelligence / Web Search (Exa AI)
# ------------------------------------------------------------------------------
# Used for live breaking crypto news, catalysts, sentiment, and web intelligence.
# Get your API key from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# ------------------------------------------------------------------------------
# 3. Bitget Unified Trading Account (UTA v3) Live Execution
# ------------------------------------------------------------------------------
# Required for live trading, balance checking, and position management.
# Create an API Key at: https://www.bitget.com/account/newapi
# Permissions needed: 'Read' and 'Trade' (Never enable 'Withdraw')
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
# Set to 'true' to use Bitget simulated / paper demo trading funds instead of real money:
BITGET_DEMO_TRADING=true